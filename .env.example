# =============================================================================
# AGENDA 2026 - ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# =============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo como `.env` en la raiz o en `apps/api/.env`.
# 2. Nunca subas tu archivo `.env` real al repositorio.
# 3. Por seguridad (regla en AGENTS.md + Hook), el agente de IA SOLO puede
#    leer y editar este `.env.example`, nunca tu `.env` real.
# =============================================================================

# Entorno de ejecucion: development | test | production
NODE_ENV=development

# Puerto del servidor Backend local (Hono)
PORT=3001

# URL permitida para CORS (Frontend Vite local)
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# BASE DE DATOS (ADR-003)
# -----------------------------------------------------------------------------
# "pglite" usa PostgreSQL embebido en carpeta local sin instalar servicios.
# "postgres" usa una conexion PostgreSQL externa (ej. Neon.tech / Supabase en Cloud).
DB_PROVIDER=pglite

# Ruta local donde PGlite guardara los datos en modo desarrollo (ignorada en Git)
PGLITE_DATA_DIR=./.local-db

# URL de conexion PostgreSQL (Solo requerida cuando DB_PROVIDER=postgres en Fase 2)
DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/agenda?sslmode=require

# -----------------------------------------------------------------------------
# AUTENTICACION Y SEGURIDAD (ADR-005)
# -----------------------------------------------------------------------------
# "local_single_user": En desarrollo local entra directo sin pedir login.
# "jwt": Exige email/password y valida tokens JWT (Obligatorio en produccion).
AUTH_MODE=local_single_user

# Usuario por defecto para el modo local_single_user
LOCAL_USER_EMAIL=local@agenda.dev
LOCAL_USER_NAME=Mi Agenda 2026

# Secreto para firmar tokens JWT (Cambia esto en tu .env real por una cadena larga aleatoria)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long
JWT_EXPIRES_IN=7d
