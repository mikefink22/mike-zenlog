{
  "name": "mike-zenlog",
  "version": "0.1.0",
  "private": true,
  "description": "Mike ZenLog — Agenda Minimalista estilo Bullet Journal. Monorepo Full-Stack TypeScript (Shared, API, Web, Mobile)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@agenda/api",
    "dev:web": "npm run dev --workspace=@agenda/web",
    "build": "npm run build --workspaces --if-present",
    "test": "node -e \"console.log('No tests to run until packages are created')\"",
    "typecheck": "node -e \"console.log('No workspaces to typecheck yet')\"",
    "lint": "node -e \"console.log('No linting to run yet')\""
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
